{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "futurebite",
	"compatibility_date": "2026-09-14",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "futurebite"
		},
		{
			"binding": "REALTIME",
			"service": "futurebite-realtime"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "futurebite-db",
			"database_id": "dc46baaa-fa18-4d1f-83f7-2408dbc29e5c"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSIONS",
			"id": "4a91cf6d032946a9a88ec05601f1d7f0"
		}
	]
}
